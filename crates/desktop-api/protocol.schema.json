{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luciddesk:control:1",
  "title": "LucidDesk read-only control protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "command"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "enum": [
            "status",
            "capabilities",
            "workspace.get",
            "pane.list",
            "pane.get",
            "item.list"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "pane": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "unassigned": {
          "type": "boolean"
        },
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "ok",
        "context",
        "data",
        "error"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "data": {},
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    }
  }
}
