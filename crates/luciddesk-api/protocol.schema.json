{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luciddesk:control:1",
  "title": "LucidDesk control protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "command"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "enum": [
            "status",
            "capabilities",
            "workspace.get",
            "pane.list",
            "pane.get",
            "item.list",
            "plan.preview",
            "plan.apply",
            "request.get"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "pane": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "unassigned": {
          "type": "boolean"
        },
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "plan.preview"
              }
            }
          },
          "then": {
            "required": [
              "plan"
            ],
            "properties": {
              "plan": {
                "$ref": "#/$defs/plan"
              }
            }
          },
          "else": {
            "properties": {
              "plan": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "plan.apply"
              }
            }
          },
          "then": {
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "else": {
            "properties": {
              "token": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "pane.get",
                  "request.get"
                ]
              }
            }
          },
          "then": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "pane.get"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "item.list"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "pane",
                "unassigned"
              ],
              "properties": {
                "pane": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "unassigned": {
                  "const": true
                }
              }
            }
          },
          "else": {
            "properties": {
              "pane": {
                "type": "null"
              },
              "unassigned": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "ok",
        "context",
        "data",
        "error"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "data": {},
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "state_version",
        "inventory_version",
        "topology_token"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "state_version": {
          "type": "string",
          "minLength": 1
        },
        "inventory_version": {
          "type": "string",
          "minLength": 1
        },
        "topology_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "base",
        "operations"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "base": {
          "$ref": "#/$defs/context"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "ref",
                  "title"
                ],
                "properties": {
                  "op": {
                    "const": "pane.create"
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "pane.update"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "locked": {
                    "type": "boolean"
                  },
                  "auto_hide": {
                    "type": "boolean"
                  },
                  "collapsed": {
                    "type": "boolean"
                  },
                  "always_on_top": {
                    "type": "boolean"
                  }
                },
                "minProperties": 3
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.assign"
                  },
                  "item_ids": {
                    "type": "array",
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "pane_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pane_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "pane_id"
                    ],
                    "properties": {
                      "pane_id": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$"
                      },
                      "pane_ref": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "required": [
                      "pane_ref"
                    ],
                    "properties": {
                      "pane_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pane_id": {
                        "type": "null"
                      }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.reorder"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "item_ids": {
                    "type": "array",
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "pane.remove"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "release_items": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.release"
                  },
                  "item_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
